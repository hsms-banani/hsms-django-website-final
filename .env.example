# Environment Variables for HSMS Django Project

# IMPORTANT: Gmail SMTP Configuration
# To use Gmail to send emails, you need to:
# 1. Have a Gmail account
# 2. Enable 2-Factor Authentication on your Google account
# 3. Generate an App Password at: https://myaccount.google.com/apppasswords
# 4. Replace the values below with your Gmail address and the 16-character app password

# Gmail SMTP Settings
GMAIL_USER=hsmsmajorseminary@gmail.com
GMAIL_APP_PASSWORD=vfxj kijd wqtv wsbl

# Example of App Password format (16 characters, no spaces):
# GMAIL_APP_PASSWORD=abcdefghijklmnop

# SECURITY NOTE: Never commit this file to version control!
# This file should be in your .gitignore

# Environment Setting
# Set to 'production' for live server (uses PostgreSQL)
# Set to 'development' for local server (uses SQLite)
ENVIRONMENT=development

# Django Settings
# DEBUG=True
# SECRET_KEY=your_secret_key_here
# ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# PostgreSQL Database Settings (Used when ENVIRONMENT=production)
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
